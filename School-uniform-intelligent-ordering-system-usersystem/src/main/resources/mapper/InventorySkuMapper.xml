<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.authguard.usersystem.mapper.InventorySkuMapper">

    <resultMap id="InventorySkuMap" type="com.authguard.usersystem.entity.InventorySku">
        <id property="skuId" column="sku_id"/>
        <result property="uniformId" column="uniform_id"/>
        <result property="sizeId" column="size_id"/>
        <result property="stockQuantity" column="stock_quantity"/>
        <result property="reservedQuantity" column="reserved_quantity"/>
        <result property="safetyStock" column="safety_stock"/>
        <result property="reorderPoint" column="reorder_point"/>
        <result property="leadTimeDays" column="lead_time_days"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="selectActiveByUniformAndSizeForUpdate" resultMap="InventorySkuMap">
        SELECT *
        FROM s_inventory_sku
        WHERE uniform_id = #{uniformId}
          AND size_id = #{sizeId}
          AND status = 'ACTIVE'
        ORDER BY sku_id DESC
        LIMIT 1
        FOR UPDATE
    </select>

    <select id="selectByIdForUpdate" resultMap="InventorySkuMap">
        SELECT *
        FROM s_inventory_sku
        WHERE sku_id = #{skuId}
        FOR UPDATE
    </select>

    <update id="updateQuantities" parameterType="com.authguard.usersystem.entity.InventorySku">
        UPDATE s_inventory_sku
        SET stock_quantity = #{stockQuantity},
            reserved_quantity = #{reservedQuantity},
            update_time = NOW()
        WHERE sku_id = #{skuId}
    </update>
</mapper>
