<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.authguard.usersystem.mapper.SStyleGuidesMapper">

    <!-- 结果映射 -->
    <resultMap id="SStyleGuidesMap" type="com.authguard.usersystem.entity.SStyleGuides">
        <id property="id" column="id" />
        <result property="uniformId" column="uniform_id" />
        <result property="title" column="title" />
        <result property="content" column="content" />
        <result property="image" column="image" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <!-- 查询所有状态为0的穿搭指南 -->
    <select id="selectAllActiveStyleGuides" resultMap="SStyleGuidesMap">
        SELECT *
        FROM S_style_guides
        WHERE status = 0
    </select>

    <!-- 根据ID查询穿搭指南 -->
    <select id="selectById" resultMap="SStyleGuidesMap">
        SELECT *
        FROM S_style_guides
        WHERE id = #{id}
    </select>

</mapper>