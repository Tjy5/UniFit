<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.authguard.usersystem.mapper.UserAccountMapper">

    <resultMap id="UserAccountResult" type="com.authguard.usersystem.entity.UserAccount">
        <id property="userId" column="user_id"/>
        <result property="userAccount" column="user_account"/>
        <result property="userPassword" column="user_password"/>
        <result property="roleId" column="role_id"/> <!-- 假设有role_id -->
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <!-- 根据您的UserAccount实体添加其他字段 -->
    </resultMap>

    <!-- 插入用户（注册） -->
    <insert id="insertUser" parameterType="com.authguard.usersystem.entity.UserAccount" useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO user_account (user_account, user_password, create_by, create_time, update_time) <!-- 添加了update_time -->
        VALUES (#{userAccount}, #{userPassword}, #{createBy}, NOW(), NOW());
    </insert>

    <!-- 通过账号查询用户（用于登录、获取用户信息） -->
    <select id="findByAccount" resultMap="UserAccountResult"> <!-- 建议使用resultMap -->
        SELECT * FROM user_account WHERE user_account = #{userAccount};
    </select>

    <!-- 更新用户密码 -->
    <!-- 注意：您原来的updatePassword SQL没有使用 oldPassword 进行验证。
         如果需要在SQL层面验证旧密码，SQL会更复杂。
         通常业务逻辑层会先查询用户，验证旧密码，然后再调用此方法更新。
         这里的SQL仅更新密码。 -->
    <update id="updatePassword">
        UPDATE user_account
        SET user_password = #{newPassword}, update_time = NOW()
        WHERE user_account = #{userAccount};
    </update>

    <!-- ⭐ 新增方法的SQL实现 -->
    <select id="selectUserById" resultMap="UserAccountResult">
        SELECT user_id, user_account, role_id, create_time, update_time, create_by <!-- 选择需要的字段, 不暴露密码 -->
        FROM user_account
        WHERE user_id = #{userId}
    </select>

</mapper>
